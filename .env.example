# Copie para .env (ou rode `python scripts/configurar.py`, que gera as chaves).
# O arquivo .env nunca vai para o Git.

# Chave da API da Anthropic (Claude). Em branco = mensagens padrão, sem IA.
ANTHROPIC_API_KEY=
AJA_LLM_MODELO=claude-haiku-5-5

# Criptografia dos dados pessoais no banco (Fernet) e índice cego (HMAC). Gere chaves novas.
AJA_CHAVE_CRIPTO=
AJA_CHAVE_INDICE=

# Conta da equipe AJA (visão executiva do dashboard)
AJA_GESTOR_EMAIL=gestor@aja.exemplo.com
AJA_GESTOR_SENHA=

# Janela do indicador de Risco Cidadão, em minutos
AJA_JANELA_RISCO_MIN=10
# 1 = permite reiniciar a base pelo dashboard (demonstração)
AJA_MODO_DEMO=1
